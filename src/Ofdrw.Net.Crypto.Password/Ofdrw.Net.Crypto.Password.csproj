<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>Optional private-profile v2 OFD password envelopes using salted bounded scrypt, independent-IV SM4-CBC and HMAC-SHA256 authentication. Legacy v1 is rejected; no vendor interoperability, certification or archival claim.</Description>
    <PackageReadmeFile>docs/password-crypto.md</PackageReadmeFile>
    <PackageTags>OFD;password;scrypt;SM4;HMAC-SHA256;authenticated;private-profile;optional</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.6.2]" />
    <ProjectReference Include="../Ofdrw.Net.Packaging/Ofdrw.Net.Packaging.csproj" />
    <Compile Include="../Ofdrw.Net.Core/IO/OfdPackagePath.cs" Link="Internal/OfdPackagePath.cs" />
    <InternalsVisibleTo Include="Ofdrw.Net.Crypto.Password.Tests" />
    <None Include="../../docs/password-crypto.md" Pack="true" PackagePath="docs/" Link="docs/password-crypto.md" />
  </ItemGroup>
</Project>
