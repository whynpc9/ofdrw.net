<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>Optional OFD encryption: private authenticated password v2 and an explicit bounded Java 2.4.0 compatible SM4/SM2 multi-recipient profile with pinned signed inventory. No certification, production PKI or archival claim.</Description>
    <PackageReadmeFile>docs/password-crypto.md</PackageReadmeFile>
    <PackageTags>OFD;password;scrypt;SM4;SM2;multi-recipient;integrity;private-profile;optional</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.6.2]" />
    <ProjectReference Include="../Ofdrw.Net.Packaging/Ofdrw.Net.Packaging.csproj" />
    <Compile Include="../Ofdrw.Net.Core/IO/OfdPackagePath.cs" Link="Internal/OfdPackagePath.cs" />
    <InternalsVisibleTo Include="Ofdrw.Net.Crypto.Password.Tests" />
    <None Include="../../docs/password-crypto.md" Pack="true" PackagePath="docs/" Link="docs/password-crypto.md" />
  </ItemGroup>
</Project>
