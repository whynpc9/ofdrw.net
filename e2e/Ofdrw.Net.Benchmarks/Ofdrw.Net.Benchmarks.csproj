<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OfdrwPackageVersion Condition="'$(OfdrwPackageVersion)' == ''">0.1.0-preview.5</OfdrwPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ofdrw.Net.Converter" Version="[$(OfdrwPackageVersion)]" />
  </ItemGroup>
</Project>
