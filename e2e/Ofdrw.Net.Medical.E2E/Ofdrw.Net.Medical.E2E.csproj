<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated package consumer: Ofdrw.Net.Medical is opt-in and must be referenced explicitly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OfdrwPackageVersion Condition="'$(OfdrwPackageVersion)' == ''">0.4.0</OfdrwPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ofdrw.Net.Medical" Version="$(OfdrwPackageVersion)" />
    <PackageReference Include="Ofdrw.Net.Layout" Version="$(OfdrwPackageVersion)" />
  </ItemGroup>
</Project>
