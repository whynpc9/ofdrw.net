<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup Condition="'$(OfdrwPackageVersion)' == ''">
    <ProjectReference Include="../../src/Ofdrw.Net.Graphics.SkiaSharp/Ofdrw.Net.Graphics.SkiaSharp.csproj" />
    <ProjectReference Include="../../src/Ofdrw.Net.Converter.Pdf/Ofdrw.Net.Converter.Pdf.csproj" />
    <ProjectReference Include="../../src/Ofdrw.Net.Reader/Ofdrw.Net.Reader.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OfdrwPackageVersion)' != ''">
    <PackageReference Include="Ofdrw.Net.Graphics.SkiaSharp" Version="$(OfdrwPackageVersion)" />
    <PackageReference Include="Ofdrw.Net.Converter.Pdf" Version="$(OfdrwPackageVersion)" />
    <PackageReference Include="Ofdrw.Net.Reader" Version="$(OfdrwPackageVersion)" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" /></ItemGroup>
<ItemGroup><None Include="testdata/fonts/*.ttf" Link="style-fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
