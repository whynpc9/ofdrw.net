tc/os-release') else None,'libc':platform.libc_ver(),'libcCommand':subprocess.run(['ldd','--version'],capture_output=True,text=True).stdout+subprocess.run(['ldd','--version'],capture_output=True,text=True).stderr if platform.system()=='Linux' else None,'results':results},indent=2))\n",
